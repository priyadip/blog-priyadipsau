---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description,
  ogImage = '/og-default.svg',
  type = 'website',
  publishDate,
  updatedDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const pageTitle = title === 'Priyadip Sau — Notes' ? title : `${title} — Priyadip Sau`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#3452e1" />

  <meta property="og:type" content={type} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
  {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

  <link rel="alternate" type="application/rss+xml" title="Priyadip Sau — Notes" href="/rss.xml" />

  <script is:inline>
    (function () {
      var stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') {
        document.documentElement.dataset.theme = stored;
      }
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <Header />
  <main id="main" class="container">
    <slot />
  </main>
  <Footer />
</body>
</html>
